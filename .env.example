# Per-machine private config - copy to .env.local, which is gitignored:
#   cp .env.example .env.local
#
# ASCII-only on purpose: this file is parsed by Windows PowerShell 5.1, which reads
# BOM-less files as ANSI. Non-ASCII text can make a GBK byte pair swallow a line
# feed, merging every line into one and silently breaking the key=value parse.
#
# Absolute paths here are machine-specific, which is exactly why they stay out of git.

# Absolute path to the conda env interpreter; empty -> falls back to 'python' on PATH
BGE_PYTHON=D:\path\to\conda\envs\bgem3\python.exe

# Model / HuggingFace cache directory; empty -> repo-local models/
# BGE_HF_HOME=D:\path\to\models

# Preset and VRAM levers (service defaults live in src/settings.py)
# BGE_PRESET=safe
# BGE_MEM_FRACTION=0.62
# BGE_TOKEN_BUDGET=8192
