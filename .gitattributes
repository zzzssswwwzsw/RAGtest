*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.safetensors binary
*.bin      binary
*.pt       binary
*.pth      binary
*.onnx     binary
*.h5       binary
*.zip      binary
*.exe      binary
*.dll      binary
*.so       binary
