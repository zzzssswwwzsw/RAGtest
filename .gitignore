# ---- Python 缓存与虚拟环境（不入库，本机可重建）----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# ---- 模型权重与 HuggingFace 缓存（大文件，走本地磁盘，禁止入库）----
models/
*.pt
*.pth
*.safetensors
*.bin
*.onnx
*.h5

# ---- 本地配置与密钥（含路径/凭据，禁止入库）----
.env
.env.*
!.env.example
config.local.*

# ---- 运行产物与日志 ----
*.log
logs/
.bench_result.json

# ---- 数据集目录（原文与派生文件一律不入库，只留目录占位）----
# 用 "忽略全部 + 放行 .gitkeep" 而不是整目录忽略：这样目录结构在仓库里可见。
# raw/ 也一并忽略：语料往往比代码敏感，进仓库会连检索结果一起泄露出去。
data/raw/*
!data/raw/.gitkeep
data/chunks/*
!data/chunks/.gitkeep
data/embeddings/*
!data/embeddings/.gitkeep

# ---- 编辑器 / 系统 -----
.vscode/
.idea/
Thumbs.db
desktop.ini
